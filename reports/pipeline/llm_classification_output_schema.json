{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "chapter_id",
    "relevance_score",
    "reason",
    "subtopics",
    "evidence_span",
    "quiz_candidate",
    "needs_review"
  ],
