{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:leren/prod/database-url*",
        "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:leren/prod/openrouter-api-key*",
        "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:leren/prod/internal-api-token*"
      ]
    }
  ]
}
