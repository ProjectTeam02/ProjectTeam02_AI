ENVIRONMENT=development
# Docker Compose publishes PostgreSQL on host port 5433.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/leren
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=550
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=600
CHUNK_OVERLAP=90
RETRIEVAL_TOP_K=4
CONTEXT_MAX_TOKENS=2800
HISTORY_MAX_TOKENS=800
CONCEPT_GRAPH_MAX_TOKENS=400
INTERNAL_API_TOKEN=
QUESTION_EVIDENCE_PATH=
QUESTION_APPROVAL_LABEL_PATH=
QUESTION_EXISTING_PATH=
QUESTION_MAX_COUNT=20
QUESTION_MAX_REVISION_ATTEMPTS=2
BOK_TERMS_S3_URI=
BOK_SOURCE_S3_URI=
QUESTION_EVIDENCE_S3_URI=
QUESTION_APPROVAL_LABEL_S3_URI=
VECTOR_STORE_COLLECTION=projectteam02
# Local Compose uses public; production ECS must set this to the backend-owned ai schema.
VECTOR_STORE_SCHEMA=public
VECTOR_STORE_PERFORM_SETUP=false
SPARSE_RETRIEVAL_ENABLED=true
RERANKING_ENABLED=false
RETRIEVAL_FUSION_K=60
RAG_STAGE_TIMEOUT_SECONDS=20
RAG_MAX_RETRIES=1
# Set both prices to enable estimated USD cost in the internal usage response.
LLM_INPUT_COST_PER_1K=
LLM_OUTPUT_COST_PER_1K=
