ENVIRONMENT=development
# Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/leren
# PyCharm/local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/leren
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leren
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_BASE_URL=
EMBEDDING_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=700
EMBEDDING_DIMENSION=1536
RETRIEVAL_TOP_K=5
CONTEXT_MAX_TOKENS=3000
HISTORY_MAX_MESSAGES=12
INTERNAL_API_TOKEN=replace-with-a-server-to-server-secret
