ENVIRONMENT=development
# Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/leren
# PyCharm/local via docker-compose host mapping: localhost:5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/leren
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30
INTERNAL_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=700
EMBEDDING_DIMENSION=1536
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
CONTEXT_MAX_TOKENS=3000
HISTORY_MAX_MESSAGES=12
HISTORY_MAX_TOKENS=1200
INTERNAL_API_TOKEN=replace-with-a-server-to-server-secret
VECTOR_STORE_COLLECTION=projectteam02
VECTOR_STORE_SCHEMA=public
APPROVED_REVIEW_STATUS=approved
GROUNDING_MIN_OVERLAP=0.12
BOK_TERMS_PATH=data/bok_terms_2026_rag.jsonl
BOK_SOURCE_PATH=data/bok_terms_2026.json
BOK_HYBRID_SEARCH_ENABLED=true
RELATED_TERM_TOP_K=2
